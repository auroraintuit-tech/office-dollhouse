{
  "expo": {
    "name": "OfficeOS",
    "slug": "officeos",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "officeos",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0D06"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.auroraintuit.officeos",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "OfficeOS использует выбранное изображение только для аватара или логотипа компании."
      }
    },
    "android": {
      "package": "com.auroraintuit.officeos"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
